{
    "name": "@vanssa/sylius-slider-plugin",
    "version": "2.3.0",
    "description": "Stimulus controllers and styles for the Vanssa Sylius Slider Plugin (Symfony UX package)",
    "license": "MIT",
    "keywords": [
        "symfony-ux",
        "sylius",
        "sylius-plugin",
        "slider",
        "stimulus"
    ],
    "homepage": "https://github.com/vanssata/sylius-slider-plugin",
    "repository": "https://github.com/vanssata/sylius-slider-plugin",
    "type": "module",
    "files": [
        "admin",
        "shop",
        "styles"
    ],
    "symfony": {
        "controllers": {
            "slider": {
                "main": "shop/controllers/slider_controller.js",
                "name": "vanssa-slider",
                "fetch": "eager",
                "enabled": true,
                "autoimport": {
                    "@vanssa/sylius-slider-plugin/shop/styles/slider.scss": true
                }
            },
            "slide-video": {
                "main": "shop/controllers/slide_video_controller.js",
                "name": "vanssa-slide-video",
                "fetch": "eager",
                "enabled": true
            },
            "slider-settings": {
                "main": "admin/controllers/slider_settings_controller.js",
                "name": "vanssa-slider-settings",
                "fetch": "lazy",
                "enabled": true
            },
            "slider-slides-preview": {
                "main": "admin/controllers/slider_slides_preview_controller.js",
                "name": "vanssa-slider-slides-preview",
                "fetch": "lazy",
                "enabled": true
            },
            "rgba-color-picker": {
                "main": "admin/controllers/rgba_color_picker_controller.js",
                "name": "vanssa-rgba-color-picker",
                "fetch": "lazy",
                "enabled": true,
                "autoimport": {
                    "@simonwep/pickr/dist/themes/classic.min.css": true
                }
            },
            "responsive-copy": {
                "main": "admin/controllers/responsive_copy_controller.js",
                "name": "vanssa-responsive-copy",
                "fetch": "lazy",
                "enabled": true
            },
            "preview-frame": {
                "main": "admin/controllers/preview_frame_controller.js",
                "name": "vanssa-preview-frame",
                "fetch": "lazy",
                "enabled": true
            },
            "preset-applier": {
                "main": "admin/controllers/preset_applier_controller.js",
                "name": "vanssa-preset-applier",
                "fetch": "lazy",
                "enabled": true
            },
            "preset-gallery": {
                "main": "admin/controllers/preset_gallery_controller.js",
                "name": "vanssa-preset-gallery",
                "fetch": "lazy",
                "enabled": true
            },
            "form-context": {
                "main": "admin/controllers/form_context_controller.js",
                "name": "vanssa-form-context",
                "fetch": "lazy",
                "enabled": true
            },
            "animation-settings": {
                "main": "admin/controllers/animation_settings_controller.js",
                "name": "vanssa-animation-settings",
                "fetch": "lazy",
                "enabled": true
            },
            "image-upload-preview": {
                "main": "admin/controllers/image_upload_preview_controller.js",
                "name": "vanssa-image-upload-preview",
                "fetch": "lazy",
                "enabled": true
            },
            "mockup-picker": {
                "main": "admin/controllers/mockup_picker_controller.js",
                "name": "vanssa-mockup-picker",
                "fetch": "lazy",
                "enabled": true
            },
            "modal-portal": {
                "main": "admin/controllers/modal_portal_controller.js",
                "name": "vanssa-modal-portal",
                "fetch": "lazy",
                "enabled": true
            },
            "textarea-autosize": {
                "main": "admin/controllers/textarea_autosize_controller.js",
                "name": "vanssa-textarea-autosize",
                "fetch": "lazy",
                "enabled": true
            }
        }
    },
    "peerDependencies": {
        "@hotwired/stimulus": "^3.0.0"
    },
    "dependencies": {
        "@hotwired/turbo": "^8.0.0",
        "@simonwep/pickr": "^1.9.0"
    }
}
