<div {{ attributes.defaults(stimulus_controller('vanssa-slider-slides-preview')) }}>
    {% if this.slides|length == 0 %}
        <div class="alert alert-info mb-0" id="vanssa-slides-empty">No slides assigned yet.</div>
    {% else %}
        {# Real id attributes keep the morph stable — idiomorph (what
           LiveComponent 2.31 morphs with) matches nodes by their id
           attribute only; the per-row preview modals get re-parented to
           <body> after the first render, so without ids the diff
           duplicated rows on attach/detach. #}
        <div id="vanssa-slides-preview-assets">
            {% include '@VanssaSyliusSliderPlugin/admin/slide/preview/_assets.html.twig' %}
        </div>
        <div class="vanssa-slider-slides-preview list-group" id="vanssa-slides-list" {{ stimulus_target('vanssa-slider-slides-preview', 'list') }}>
            {% for slide in this.slides %}
                {% set slideId = slide.id %}
                {% set slideName = slide.name %}
                {% set hasVideo = slide.slideCoverVideo %}
                {% set hasImage = slide.slideCover %}
                {% set localizedSettings = slide.localizedSlideSettings(app.request.locale, sylius.channel.defaultLocale.code|default(null)) %}
                {% set responsiveDesktop = localizedSettings.responsive.desktop|default({}) %}
                {% set slideTitle = responsiveDesktop.title|default('') %}
                {% set slideDescription = responsiveDesktop.description|default('') %}
                {% set contentHorizontal = responsiveDesktop.contentHorizontalPosition|default('start') %}
                {% set contentVertical = responsiveDesktop.contentVerticalPosition|default('bottom') %}
                <article
                    class="list-group-item vanssa-slider-slides-preview__item {{ not slide.enabled ? 'is-disabled' : '' }}"
                    draggable="true"
                    {# Morph key (idiomorph matches by id): drag reorder and
                       modal re-parenting mutate this list outside the
                       component — without ids the diff duplicates rows. #}
                    id="vanssa-slide-item-{{ slideId }}"
                    data-slide-id="{{ slideId }}"
                    {{ stimulus_target('vanssa-slider-slides-preview', 'item') }}
                    data-action="dragstart->vanssa-slider-slides-preview#onDragStart dragover->vanssa-slider-slides-preview#onDragOver drop->vanssa-slider-slides-preview#onDrop dragend->vanssa-slider-slides-preview#onDragEnd"
                >
                    <div class="vanssa-slider-slides-preview__drag-handle" title="Drag to reorder">⋮⋮</div>

                    <div class="vanssa-slider-slides-preview__media">
                        {% if hasImage %}
                            <img src="{{ slide.slideCover }}" alt="{{ slideTitle ?: slideName }}">
                        {% elseif hasVideo %}
                            <div class="vanssa-slider-slides-preview__video-placeholder">
                                {{ ux_icon('tabler:video', {'class': 'icon'}) }}
                            </div>
                        {% else %}
                            <div class="vanssa-slider-slides-preview__image-placeholder"></div>
                        {% endif %}
                    </div>

                    <div class="vanssa-slider-slides-preview__content flex-grow-1" style="min-width: 0;">
                        <div class="fw-bold text-truncate">{{ slideTitle ?: slideName }}</div>
                        <div class="text-muted small text-truncate">
                            {{ slide.code }}
                            {%- if hasVideo %} · Video{% endif %}
                            {%- if not slide.enabled %} · <span class="text-danger">Disabled</span>{% endif %}
                        </div>
                    </div>

                    <div class="vanssa-slider-slides-preview__actions d-flex align-items-center gap-1">
                        {% include '@VanssaSyliusSliderPlugin/admin/slide/preview/_trigger.html.twig' with { slide: slide, icon_only: true } only %}
                        <a class="btn btn-icon btn-sm btn-ghost-secondary" href="{{ path('vanssa_sylius_slider_admin_slide_update', {'id': slideId}) }}" title="{{ 'sylius.ui.edit'|trans }}" aria-label="{{ 'sylius.ui.edit'|trans }}">
                            {{ ux_icon('tabler:pencil', {'class': 'icon'}) }}
                        </a>
                        {# Detaches the slide from THIS slider only — the
                           slide itself is never deleted here. #}
                        <button
                            type="button"
                            class="btn btn-icon btn-sm btn-ghost-danger"
                            data-action="live#action:prevent"
                            data-live-action-param="removeSlide"
                            data-live-slide-id-param="{{ slideId }}"
                            title="Remove from this slider (the slide is kept)"
                            aria-label="Remove from this slider"
                        >
                            {{ ux_icon('tabler:unlink', {'class': 'icon'}) }}
                        </button>
                    </div>
                </article>
            {% endfor %}
        </div>

        <button
            type="button"
            class="d-none"
            {{ stimulus_target('vanssa-slider-slides-preview', 'reorderTrigger') }}
            data-action="live#action:prevent"
            data-live-action-param="reorderSlides"
        ></button>
    {% endif %}
</div>
