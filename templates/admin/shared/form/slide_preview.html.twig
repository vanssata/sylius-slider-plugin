{# Live preview of a slide.
   - slide: the Slide entity (media backdrop per breakpoint, desktop fallback)
   - locales: optional list of locale codes — renders a language selector for the previewed texts
   - default_locale: locale used when none is selected (fallback language) #}
{% set slide = slide|default(null) %}
{% set locales = locales|default([]) %}
{% set default_locale = default_locale|default(locales|first) %}

{% set preview_media = {
    desktop: {
        video: slide ? slide.slideCoverVideo : null,
        image: slide ? (slide.slideCover ?: slide.slideCoverTablet ?: slide.slideCoverMobile) : null,
    },
    tablet: {
        video: slide ? (slide.slideCoverVideoTablet ?: slide.slideCoverVideo) : null,
        image: slide ? (slide.slideCoverTablet ?: slide.slideCover ?: slide.slideCoverMobile) : null,
    },
    mobile: {
        video: slide ? (slide.slideCoverVideoMobile ?: slide.slideCoverVideo) : null,
        image: slide ? (slide.slideCoverMobile ?: slide.slideCover ?: slide.slideCoverTablet) : null,
    },
} %}
{% set has_media = preview_media.desktop.video or preview_media.desktop.image %}

<div class="card mt-3">
    <div class="card-header d-flex flex-wrap gap-2 justify-content-between align-items-center">
        <h3 class="card-title mb-0">Live preview</h3>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            {% if locales|length > 0 %}
                <select
                    class="form-select form-select-sm w-auto"
                    aria-label="Preview language"
                    {{ stimulus_target('vanssa-slide-preview', 'localeSelect') }}
                    data-action="change->vanssa-slide-preview#refresh"
                >
                    {% for locale in locales %}
                        <option value="{{ locale }}" {% if locale == default_locale %}selected{% endif %}>{{ locale }}</option>
                    {% endfor %}
                </select>
            {% endif %}
            <div class="btn-group" role="group" aria-label="Preview resolution">
                {% for breakpoint, width in { desktop: '100%', tablet: '768px', mobile: '390px' } %}
                    <button
                        type="button"
                        class="btn btn-sm btn-outline-secondary{% if loop.first %} active{% endif %}"
                        {{ stimulus_target('vanssa-slide-preview', 'sizeButton') }}
                        data-action="vanssa-slide-preview#switchSize"
                        data-vanssa-slide-preview-breakpoint-param="{{ breakpoint }}"
                        data-vanssa-slide-preview-width-param="{{ width }}"
                    >
                        <i class="bi bi-{{ breakpoint == 'desktop' ? 'display' : (breakpoint == 'tablet' ? 'tablet' : 'phone') }}"></i>
                    </button>
                {% endfor %}
            </div>
        </div>
    </div>
    <div class="card-body">
        <div
            class="vanssa-slide-preview{{ has_media ? ' has-media' : '' }} mx-auto"
            style="max-width: 100%; transition: max-width 200ms ease;"
            data-default-locale="{{ default_locale }}"
            {{ stimulus_target('vanssa-slide-preview', 'frame') }}
        >
            {% for breakpoint, media in preview_media %}
                {% if media.video %}
                    <video
                        class="vanssa-slide-preview__media{% if breakpoint != 'desktop' %} d-none{% endif %}"
                        muted loop playsinline preload="metadata" autoplay
                        data-breakpoint="{{ breakpoint }}"
                        {{ stimulus_target('vanssa-slide-preview', 'media') }}
                    >
                        <source src="{{ media.video }}">
                    </video>
                {% elseif media.image %}
                    <img
                        class="vanssa-slide-preview__media{% if breakpoint != 'desktop' %} d-none{% endif %}"
                        src="{{ media.image }}"
                        alt=""
                        data-breakpoint="{{ breakpoint }}"
                        {{ stimulus_target('vanssa-slide-preview', 'media') }}
                    >
                {% endif %}
            {% endfor %}
            <div class="vanssa-slide-preview__content is-pos-x-start is-pos-y-bottom" {{ stimulus_target('vanssa-slide-preview', 'previewBox') }}>
                <div class="vanssa-slide-preview__heading d-none" {{ stimulus_target('vanssa-slide-preview', 'previewHeading') }}></div>
                <p class="vanssa-slide-preview__description d-none" {{ stimulus_target('vanssa-slide-preview', 'previewDescription') }}></p>
            </div>
        </div>
    </div>
</div>
