{# Reusable "Edit" button + modal for a single slide — usable anywhere a
   slide is listed (the slider's "Slides in this slider" list, admin grid
   rows), not just the slide edit page. Opens the edit modal (live preview +
   the real SlideType form). For a custom-styled trigger button, include
   _modal.html.twig directly instead and build the button yourself.

   Include preview/_assets.html.twig ONCE per page alongside this
   (possibly-repeated) partial for the shared shop stylesheet. #}
{% set slide = slide|default(null) %}
{% set label = label|default('sylius.ui.edit'|trans) %}
{% set icon_only = icon_only|default(false) %}
{% set button_class = button_class|default(icon_only ? 'btn btn-icon btn-sm btn-ghost-secondary' : 'btn btn-outline-primary btn-sm') %}

{% if slide is not null and slide.id is not null %}
    {# <a>, not <button>: Sylius's compound-form-errors controller crashes on
       in-form buttons whose data-bs-target modal is hoisted to <body>
       (vanssa-preview-frame), and this trigger is embedded in forms. #}
    <a
        href="#vanssa-slide-preview-modal-{{ slide.id }}"
        role="button"
        class="{{ button_class }}"
        data-bs-toggle="modal"
        data-bs-target="#vanssa-slide-preview-modal-{{ slide.id }}"
        {% if icon_only %}title="{{ label }}" aria-label="{{ label }}"{% endif %}
    >
        {{ ux_icon('tabler:pencil', {'class': icon_only ? 'icon' : 'icon me-1'}) }}{% if not icon_only %} {{ label }}{% endif %}
    </a>
    {% include '@VanssaSyliusSliderPlugin/admin/slide/preview/_modal.html.twig' with { slide: slide } only %}
{% endif %}
