{# Custom grid action: opens the slide edit modal (live preview + the real
   SlideType form) instead of navigating to the full edit page — the modal's
   header links to the full workspace editor. #}
{% include '@VanssaSyliusSliderPlugin/admin/slide/preview/_assets.html.twig' %}
{% include '@VanssaSyliusSliderPlugin/admin/slide/preview/_modal.html.twig' with { slide: data } only %}

<button
    type="button"
    class="btn btn-icon"
    data-bs-toggle="modal"
    data-bs-target="#vanssa-slide-preview-modal-{{ data.id }}"
    title="{{ 'sylius.ui.edit'|trans }}"
    aria-label="{{ 'sylius.ui.edit'|trans }}"
>
    {{ ux_icon(action.icon|default('tabler:pencil')) }}
</button>
