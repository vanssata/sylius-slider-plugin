{# Custom grid action: opens the same preview modal used on the slide edit
   page, read-only (no #slide form present on a grid page, so the modal's
   Settings/Update parts are dropped — see preview_frame_controller.js). #}
{% include '@VanssaSyliusSliderPlugin/admin/slide/preview/_assets.html.twig' %}
{% include '@VanssaSyliusSliderPlugin/admin/slide/preview/_modal.html.twig' with { slide: data } only %}

<button
    type="button"
    class="btn btn-icon"
    data-bs-toggle="modal"
    data-bs-target="#vanssa-slide-preview-modal-{{ data.id }}"
    title="{{ 'Preview'|trans }}"
>
    {{ ux_icon(action.icon|default('tabler:eye')) }}
</button>
