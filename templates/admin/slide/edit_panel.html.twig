<!DOCTYPE html>
{# Turbo-frame fragment serving the REAL SlideType edit form to the slide
   preview modal (see SlideEditPanelController). Rendered as a full HTML
   document for direct access, but when fetched into the modal's frame Turbo
   keeps only the matching <turbo-frame> below — anything in <head> is
   discarded, so no assets are declared here (the host admin page already
   has them). #}
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="robots" content="noindex, nofollow">
    <title>{{ slide.code }} — edit panel</title>
</head>
<body>
    <turbo-frame id="vanssa-slide-edit-panel-{{ slide.id }}" class="vanssa-slider-admin" data-controller="vanssa-form-context">
        {% if saved %}
            <div class="alert alert-success" role="alert">Slide has been successfully updated.</div>
        {% endif %}

        {% form_theme form '@SyliusAdmin/shared/form_theme.html.twig' %}
        {{ form_start(form, {
            'action': path('vanssa_sylius_slider_admin_slide_edit_panel', { id: slide.id }),
            'attr': { 'novalidate': 'novalidate', 'id': form.vars.id },
        }) }}
            {{ form_errors(form) }}
            {# render_rest is disabled below — the CSRF token must be explicit. #}
            {{ form_widget(form._token) }}

            {% hook 'vanssa_sylius_slider.slide_edit_panel' with { form, resource: slide } %}

            {# The Update button lives in the modal footer (form="slide") so
               it sits next to Close; standalone (non-modal) access still
               needs an in-form submit. No d-flex here: Bootstrap utilities
               carry !important and would defeat the modal's display:none
               guard (preview_modal.scss) — and the standalone document loads
               no stylesheets anyway. #}
            <div class="my-3" data-vanssa-standalone-submit>
                <button type="submit" class="btn btn-primary">{{ 'sylius.ui.update'|trans }}</button>
            </div>
        {{ form_end(form, { render_rest: false }) }}
    </turbo-frame>
</body>
</html>
