{% set form = hookable_metadata.context.form %}
{% set translation = form.vars.data %}
{% set slide = translation is not null ? translation.translatable : null %}

<div class="col-12" data-controller="slider-settings vanssa-slide-preview">
    {# Translated texts — always applied for this locale, no override needed. #}
    <div class="row">
        <div class="col-12">{{ form_row(form.name) }}</div>
        <div class="col-12 col-md-6">{{ form_row(form.settings.responsive.desktop.title, { label: 'Title', attr: {'data-preview-field': 'title'} }) }}</div>
        <div class="col-12 col-md-6">{{ form_row(form.settings.responsive.desktop.description, { label: 'Content', attr: {'data-preview-field': 'description'} }) }}</div>
    </div>

    <hr>

    {# Button / link override #}
    <div class="row">
        <div class="col-12">{{ form_row(form.addButton) }}</div>
    </div>
    <div class="row" data-slider-settings-button-only>
        <div class="col-12 col-md-6">{{ form_row(form.buttonLabel) }}</div>
        <div class="col-12 col-md-6">{{ form_row(form.url) }}</div>
    </div>

    <hr>

    {# Media override #}
    <div class="row">
        <div class="col-12">{{ form_row(form.overrideMedia) }}</div>
    </div>
    <div data-slider-settings-media-override-only>
        {% set translation_media = [
            { key: 'desktop', image_field: form.slideCoverFile, image_path: translation ? translation.slideCover : null, video_field: form.slideCoverVideoFile, video_path: translation ? translation.slideCoverVideo : null },
            { key: 'mobile', image_field: form.slideCoverMobileFile, image_path: translation ? translation.slideCoverMobile : null, video_field: form.slideCoverVideoMobileFile, video_path: translation ? translation.slideCoverVideoMobile : null },
            { key: 'tablet', image_field: form.slideCoverTabletFile, image_path: translation ? translation.slideCoverTablet : null, video_field: form.slideCoverVideoTabletFile, video_path: translation ? translation.slideCoverVideoTablet : null },
        ] %}
        {% for media in translation_media %}
            <div class="row align-items-end">
                <div class="col-12"><h4 class="h6 mt-2">{{ media.key|capitalize }}</h4></div>
                <div class="col-12 col-md-6">
                    {% include '@VanssaSyliusSliderPlugin/admin/shared/form/image_upload_preview_field.html.twig' with {
                        field: media.image_field,
                        image_path: media.image_path,
                        preview_id: form.vars.id ~ '-' ~ media.key ~ '-preview'
                    } %}
                </div>
                <div class="col-12 col-md-6">
                    {{ form_row(media.video_field, { label: 'Video', help: 'Optional video for the ' ~ media.key ~ ' version of this locale.' }) }}
                    {% if media.video_path %}
                        <div class="text-secondary small mt-1"><i class="bi bi-camera-video me-1"></i>{{ media.video_path }}</div>
                    {% endif %}
                </div>
            </div>
        {% endfor %}
    </div>

    <hr>

    {# Display settings override (layout, heading tag, colors, effects) #}
    <div class="row">
        <div class="col-12">{{ form_row(form.overrideSettings) }}</div>
    </div>
    <div data-slider-settings-settings-override-only>
        {% include '@VanssaSyliusSliderPlugin/admin/slide/form/sections/_responsive_settings.html.twig' with {
            responsive_form: form.settings.responsive,
            responsive_id: form.vars.id ~ '-responsive',
            skip_desktop_texts: true
        } %}

        <div class="row mt-3">
            <div class="col-12">{% include '@VanssaSyliusSliderPlugin/admin/shared/form/slide_preview.html.twig' with { slide: slide } %}</div>
        </div>
    </div>
</div>
