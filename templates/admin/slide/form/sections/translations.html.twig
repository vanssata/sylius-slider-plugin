{% import '@SyliusAdmin/shared/helper/translations.html.twig' as translations %}
{% set form = hookable_metadata.context.form %}
{% set prefixes = hookable_metadata.prefixes %}
{# Edit pages are toolbar-driven: the preview panel's language dropdown picks
   which locale's fields are visible (form_context_controller) — no per-locale
   accordion. Create pages keep the classic accordion. #}
{% set toolbar_driven = form.vars.data.id|default(null) is not null %}

{% if toolbar_driven %}
    <div class="card mb-3 vanssa-slider-admin d-none" data-vanssa-context-locale="__locales__">
        <div class="card-header">
            <h2 class="card-title">
                {{ 'sylius.ui.translations'|trans }}
            </h2>
        </div>
        <div class="card-body row">
            <div class="col-12">
                {% for locale, translation_form in form.translations %}
                    <div class="d-none" data-vanssa-context-locale="{{ locale }}">
                        <h3 class="mb-3">{{ locale|sylius_locale_name }}</h3>
                        <div class="row">
                            {% hook 'translations' with { form: translation_form, locale, _prefixes: prefixes } %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
{% else %}
    <div class="card mb-3 vanssa-slider-admin">
        <div class="card-header">
            <h2 class="card-title">
                {{ 'sylius.ui.translations'|trans }}
            </h2>
        </div>
        <div class="card-body row">
            <div class="col-12">
                {{ translations.with_hook(form.translations, prefixes, null, {accordion_id: 'slide-translations', accordion_flush: true}) }}
            </div>
        </div>
    </div>
{% endif %}
