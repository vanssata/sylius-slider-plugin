<!DOCTYPE html>
<html lang="{{ localeCode|slice(0, 2) }}"{% if themeName %} data-theme="{{ themeName }}"{% endif %}>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>{{ slider.localizedName(localeCode, fallbackLocaleCode) }} — {{ channel.name }} ({{ localeCode }})</title>
    {% for entrypoint in shopEntrypoints %}
        {% set entry_parts = entrypoint|split(':') %}
        {% if entry_parts|length > 1 %}
            {{ encore_entry_link_tags(entry_parts[1], null, entry_parts[0]) }}
        {% else %}
            {{ encore_entry_link_tags(entry_parts[0]) }}
        {% endif %}
    {% endfor %}
    <style>
        body.vanssa-slider-preview-body {
            margin: 0;
            background: #f4f5f7;
        }
    </style>
    {# No is-anim override needed anymore: the vanssa-slider controller runs
       both standalone (script tags below) and embedded (registered in the
       ADMIN Stimulus app — see assets/admin/entrypoint.js), so .is-in-view
       arrives via its IntersectionObserver and the entrance animations play
       exactly like the storefront. #}
</head>
<body class="vanssa-slider-preview-body">
    <turbo-frame id="vanssa-slider-preview-frame-{{ slider.id }}">
        {{ component('vanssa_sylius_slider:shop:slider', {
            slider: slider,
            localeCode: localeCode,
            fallbackLocaleCode: fallbackLocaleCode,
            previewBreakpoint: breakpoint
        }) }}
    </turbo-frame>

    {% for entrypoint in shopEntrypoints %}
        {% set entry_parts = entrypoint|split(':') %}
        {% if entry_parts|length > 1 %}
            {{ encore_entry_script_tags(entry_parts[1], null, entry_parts[0]) }}
        {% else %}
            {{ encore_entry_script_tags(entry_parts[0]) }}
        {% endif %}
    {% endfor %}
</body>
</html>
