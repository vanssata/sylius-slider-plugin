<!DOCTYPE html>
<html lang="{{ localeCode|slice(0, 2) }}"{% if themeName %} data-theme="{{ themeName }}"{% endif %}>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>{{ slider.localizedName(localeCode, fallbackLocaleCode) }} — {{ channel.name }} ({{ localeCode }})</title>
    {% for entrypoint in shopEntrypoints %}
        {% set entry_parts = entrypoint|split(':') %}
        {% if entry_parts|length > 1 %}
            {{ encore_entry_link_tags(entry_parts[1], null, entry_parts[0]) }}
        {% else %}
            {{ encore_entry_link_tags(entry_parts[0]) }}
        {% endif %}
    {% endfor %}
    <style>
        body.vanssa-slider-preview-body {
            margin: 0;
            background: #f4f5f7;
        }

        /* The content-reveal animation (is-anim-*) is normally gated behind
           an .is-in-view class that the shop's vanssa-slider Stimulus
           controller adds via IntersectionObserver. This preview loads the
           theme's CSS but not its JS (see preview_button.html.twig), so
           without this override the content stays permanently hidden. */
        #vanssa-slider-preview-frame-{{ slider.id }} .vanssa-slider .vanssa-slide__content-box.is-anim-fade-up,
        #vanssa-slider-preview-frame-{{ slider.id }} .vanssa-slider .vanssa-slide__content-box.is-anim-fade-right,
        #vanssa-slider-preview-frame-{{ slider.id }} .vanssa-slider .vanssa-slide__content-box.is-anim-zoom-in {
            opacity: 1;
            animation: none;
        }
    </style>
</head>
<body class="vanssa-slider-preview-body">
    <turbo-frame id="vanssa-slider-preview-frame-{{ slider.id }}">
        {{ component('vanssa_sylius_slider:shop:slider', {
            slider: slider,
            localeCode: localeCode,
            fallbackLocaleCode: fallbackLocaleCode
        }) }}
    </turbo-frame>

    {% for entrypoint in shopEntrypoints %}
        {% set entry_parts = entrypoint|split(':') %}
        {% if entry_parts|length > 1 %}
            {{ encore_entry_script_tags(entry_parts[1], null, entry_parts[0]) }}
        {% else %}
            {{ encore_entry_script_tags(entry_parts[0]) }}
        {% endif %}
    {% endfor %}
</body>
</html>
