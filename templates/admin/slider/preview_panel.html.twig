<div class="col-12">
    <div
        class="card mt-3 mb-0"
        data-controller="vanssa-slider-preview-frame"
        data-vanssa-slider-preview-frame-url-template-value="{{ path('vanssa_sylius_slider_admin_slider_preview', { id: this.slider.id, channel: '__CHANNEL__', locale: '__LOCALE__' }) }}"
    >
        <div class="card-header d-flex justify-content-between align-items-center">
            <h2 class="card-title mb-0">Preview</h2>
            <a
                class="btn btn-sm btn-outline-secondary d-none"
                target="_blank"
                rel="noopener"
                data-vanssa-slider-preview-frame-target="openTab"
            >
                <i class="bi bi-box-arrow-up-right me-1"></i> Open in new tab
            </a>
        </div>
        <div class="card-body">
            <div class="row g-2 align-items-end mb-3">
                <div class="col-12 col-md-4">
                    <label class="form-label">Channel</label>
                    <select class="form-select" data-vanssa-slider-preview-frame-target="channel" data-action="change->vanssa-slider-preview-frame#refresh">
                        <option value="">Select channel…</option>
                        {% for channel in this.channels %}
                            <option value="{{ channel.code }}" data-default-locale="{{ channel.defaultLocale ? channel.defaultLocale.code : '' }}">{{ channel.name }} ({{ channel.code }})</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label">Language</label>
                    <select class="form-select" data-vanssa-slider-preview-frame-target="locale" data-action="change->vanssa-slider-preview-frame#refresh">
                        <option value="">Select language…</option>
                        {% for locale in this.locales %}
                            <option value="{{ locale.code }}">{{ locale.name }} ({{ locale.code }})</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-12 col-md-4">
                    <div class="btn-group w-100" role="group" aria-label="Preview resolution">
                        <button type="button" class="btn btn-outline-secondary active" data-vanssa-slider-preview-frame-target="sizeButton" data-action="vanssa-slider-preview-frame#resize" data-vanssa-slider-preview-frame-width-param="100%">
                            <i class="bi bi-display me-1"></i> Desktop
                        </button>
                        <button type="button" class="btn btn-outline-secondary" data-vanssa-slider-preview-frame-target="sizeButton" data-action="vanssa-slider-preview-frame#resize" data-vanssa-slider-preview-frame-width-param="768px">
                            <i class="bi bi-tablet me-1"></i> Tablet
                        </button>
                        <button type="button" class="btn btn-outline-secondary" data-vanssa-slider-preview-frame-target="sizeButton" data-action="vanssa-slider-preview-frame#resize" data-vanssa-slider-preview-frame-width-param="390px">
                            <i class="bi bi-phone me-1"></i> Mobile
                        </button>
                    </div>
                </div>
            </div>

            <div class="text-secondary text-center border rounded p-4" data-vanssa-slider-preview-frame-target="placeholder">
                Select a channel and a language to preview the slider with the storefront styles of that channel.
            </div>

            <div class="d-none border rounded overflow-auto bg-body" data-vanssa-slider-preview-frame-target="frameWrapper">
                <iframe
                    title="Slider preview"
                    class="d-block border-0 mx-auto"
                    style="width: 100%; height: 640px;"
                    loading="lazy"
                    data-vanssa-slider-preview-frame-target="frame"
                ></iframe>
            </div>
        </div>
    </div>
</div>
