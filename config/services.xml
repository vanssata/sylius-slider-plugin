<?xml version="1.0" encoding="UTF-8" ?>

<container
        xmlns="http://symfony.com/schema/dic/services"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd"
>
    <imports>
        <import resource="services/**" />
    </imports>

    <services>
        <defaults autowire="true" autoconfigure="true" public="false">
            <bind key="$projectDir">%kernel.project_dir%</bind>
            <bind key="$sliderPresets">%vanssa_sylius_slider.presets%</bind>
        </defaults>

        <prototype namespace="Vanssa\SyliusSliderPlugin\" resource="../src/*" exclude="../src/{DependencyInjection,Entity,Factory,Migrations,VanssaSyliusSliderPlugin.php}" />

        <service id="Vanssa\SyliusSliderPlugin\Controller\Shop\SliderController" public="true" />

        <service id="Vanssa\SyliusSliderPlugin\Controller\Admin\SliderPreviewController" public="true">
            <argument key="$profiler" type="service" id="profiler" on-invalid="null" />
        </service>

        <service id="Vanssa\SyliusSliderPlugin\Context\Admin\PreviewChannelContext">
            <tag name="sylius.context.channel" priority="192" />
        </service>
    </services>
</container>
